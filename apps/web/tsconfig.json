{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tell/schema": [
        "../../packages/schema/src"
      ],
      "@tell/taste": [
        "../../packages/taste/src"
      ],
      "@tell/redesign": [
        "../../packages/redesign/src"
      ],
      "@tell/redesign/llm": [
        "../../packages/redesign/src/llm-restyle.ts"
      ],
      "@tell/core": [
        "../../packages/core/src"
      ],
      "@tell/design-skills": [
        "../../packages/design-skills/src"
      ],
      "@tell/design-skills/training-data-sink": [
        "../../packages/design-skills/src/training-data-sink.ts"
      ]
    },
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
