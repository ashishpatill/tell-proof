{
  "name": "@tell/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tell": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --external @tell/core --external @tell/schema --external @tell/taste",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tell/core": "workspace:*",
    "@tell/schema": "workspace:*",
    "@tell/taste": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
