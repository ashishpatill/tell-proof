{
  "name": "tell",
  "private": true,
  "version": "0.1.0",
  "description": "Every AI-built UI has a tell — capture, diagnose, art-direct, reconcile in Cursor.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -F @tell/web dev",
    "dev:fixture": "pnpm -F @tell/generic-app dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r typecheck",
    "capture:fixture": "pnpm -F @tell/core capture:fixture",
    "diagnose:fixture": "pnpm -F @tell/core diagnose:fixture",
    "dogfood:web": "pnpm -F @tell/core exec tsx src/scripts/dogfood-web.ts",
    "verify:directions": "pnpm exec tsx .verification-screenshots/capture-directions.ts",
    "pr:diagnose": "pnpm -F @tell/schema build && pnpm -F @tell/core build && pnpm -F @tell/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/pr-diagnose.ts",
    "proof:compare": "pnpm -F @tell/schema build && pnpm -F @tell/core build && pnpm -F @tell/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/pr-proof-compare.ts",
    "proof:matrix": "pnpm -F @tell/schema build && pnpm -F @tell/core build && pnpm -F @tell/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/pr-proof-matrix.ts",
    "capture:matrix": "pnpm -F @tell/schema build && pnpm -F @tell/core build && pnpm -F @tell/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/capture-scenario-matrix.ts",
    "auth:fixture": "pnpm -F @tell/core exec tsx --tsconfig ../../packages/core/tsconfig.json ../../scripts/mint-fixture-auth.ts",
    "corpus:generate": "python3 scripts/generate-corpus-captures.py",
    "sync:demo-report": "pnpm -F @tell/core exec tsx ../../scripts/sync-demo-report.ts",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "e2e:studio": "pnpm -F @tell/core exec tsx ../../scripts/e2e-studio-playwright.ts",
    "record:readme-demo": "pnpm exec tsx scripts/record-readme-demo.ts",
    "capture:readme-showcase": "pnpm -F @tell/core exec tsx ../../scripts/capture-readme-showcase.ts",
    "media:webp": "bash scripts/optimize-readme-media.sh --prune",
    "research:forensics": "pnpm -F @tell/core exec tsx ../../scripts/design-research/forensics.ts",
    "research:aggregate": "pnpm -F @tell/core exec tsx ../../scripts/design-research/aggregate.ts",
    "research:critique": "pnpm -F @tell/design-skills exec tsx ../../scripts/design-research/critique.ts",
    "research:shots": "pnpm -F @tell/design-skills exec tsx ../../scripts/design-research/shots.ts",
    "research:audit": "pnpm -F @tell/design-skills exec tsx ../../scripts/design-research/layout-audit.ts",
    "research:inspect": "pnpm -F @tell/design-skills exec tsx ../../scripts/design-research/inspect.ts"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
